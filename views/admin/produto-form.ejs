<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= produto ? 'Editar Produto' : 'Cadastrar Produtos' %> - Agro Giuss</title>
    <link rel="stylesheet" href="/css/estilos-admin.css">
</head>
<body>

    <%- include('partials/topbar', { searchAction: '/admin/estoque', searchPlaceholder: 'Pesquisar produtos' }) %>

    <div class="adm-layout">
        <%- include('partials/sidebar', {
            menuAtivo: 'cadastro',
            nav05Label: 'Cadastrar produtos',
            nav05Href: '/admin/produtos/novo',
            proximaAcao: 'Revise os dados obrigatórios antes de concluir o cadastro.'
        }) %>

        <main>
            <form action="<%= produto ? ('/admin/produtos/' + produto.id_produto + '/salvar') : '/admin/produtos/salvar' %>" method="POST" id="formProduto">
                <!-- Cabeçalho -->
                <div class="adm-header-row">
                    <div>
                        <h1 class="adm-page-title"><%= produto ? 'Editar produto' : 'Cadastrar produtos' %></h1>
                        <p class="adm-page-sub">Cadastre novos SKUs com nome, preço, categoria e descrição, mantendo a operação organizada e escalável.</p>
                    </div>
                    <div class="adm-header-actions">
                        <a href="/admin/estoque" class="btn-adm-outline">Cancelar</a>
                        <button type="submit" class="btn-adm-primary"><%= produto ? 'Salvar alterações' : 'Cadastrar produto' %></button>
                    </div>
                </div>

                <% if (typeof erro !== 'undefined' && erro) { %>
                    <div class="adm-alert adm-alert-error"><%= erro %></div>
                <% } %>

                <!-- Card Principal do Formulário (Screenshot 6) -->
                <div class="adm-form-card">
                    <div class="adm-form-head">
                        <div>
                            <h2>Dados do produto</h2>
                            <p>Preencha os campos obrigatórios para <%= produto ? 'atualizar o SKU' : 'criar um novo SKU' %> no catálogo.</p>
                        </div>
                        <span class="adm-draft-pill"><%= produto ? 'Edição' : 'Rascunho' %></span>
                    </div>

                    <!-- Linha 1: Nome do produto + Preço -->
                    <div class="adm-form-row-2">
                        <div class="adm-field-group">
                            <label class="adm-field-label" for="nome">Nome do produto</label>
                            <input 
                                type="text" 
                                id="nome" 
                                name="nome" 
                                class="adm-field-input" 
                                placeholder="Ex: Pá de construção" 
                                required
                                value="<%= produto ? produto.nome : '' %>"
                                oninput="atualizarValidacoes()"
                            >
                            <span class="adm-field-hint">Campo obrigatório</span>
                        </div>

                        <div class="adm-field-group">
                            <label class="adm-field-label" for="valor_custo">Preço</label>
                            <input 
                                type="text" 
                                id="valor_custo" 
                                name="valor_custo" 
                                class="adm-field-input" 
                                placeholder="R$ 89,90" 
                                required
                                value="<%= produto ? ('R$ ' + Number(produto.valor_custo).toFixed(2).replace('.', ',')) : '' %>"
                                oninput="atualizarValidacoes()"
                            >
                            <span class="adm-field-hint">Campo obrigatório</span>
                        </div>
                    </div>

                    <!-- Linha 2: Categoria + Estoque Inicial + Estoque Mínimo -->
                    <div class="adm-form-row-3">
                        <div class="adm-field-group">
                            <label class="adm-field-label" for="id_categoria">Categoria</label>
                            <select 
                                id="id_categoria" 
                                name="id_categoria" 
                                class="adm-field-select" 
                                required
                                onchange="atualizarValidacoes()"
                            >
                                <option value="">Selecione uma categoria</option>
                                <% categorias.forEach(function(cat) { 
                                    const isSelected = (produto && Number(produto.id_categoria) === Number(cat.id_categoria)) ||
                                                       (!produto && typeof categoriaSelecionada !== 'undefined' && Number(categoriaSelecionada) === Number(cat.id_categoria));
                                %>
                                    <option value="<%= cat.id_categoria %>" <%= isSelected ? 'selected' : '' %>><%= cat.nome %></option>
                                <% }); %>
                            </select>
                            <span class="adm-field-hint">Campo obrigatório</span>
                        </div>

                        <div class="adm-field-group">
                            <label class="adm-field-label" for="quantidade_estoque">Estoque atual (un.)</label>
                            <input 
                                type="number" 
                                id="quantidade_estoque" 
                                name="quantidade_estoque" 
                                class="adm-field-input" 
                                min="0"
                                value="<%= produto ? produto.quantidade_estoque : 20 %>"
                            >
                            <span class="adm-field-hint">Quantidade disponível</span>
                        </div>

                        <div class="adm-field-group">
                            <label class="adm-field-label" for="estoque_minimo">Estoque mínimo (alerta)</label>
                            <input 
                                type="number" 
                                id="estoque_minimo" 
                                name="estoque_minimo" 
                                class="adm-field-input" 
                                min="0"
                                value="<%= produto ? produto.estoque_minimo : 5 %>"
                            >
                            <span class="adm-field-hint">Gera alerta quando atingir</span>
                        </div>
                    </div>

                    <!-- Linha 3: Descrição -->
                    <div class="adm-field-group">
                        <label class="adm-field-label" for="observacao">Descrição</label>
                        <textarea 
                            id="observacao" 
                            name="observacao" 
                            class="adm-field-textarea" 
                            placeholder="Pá de construção para uso em obras, reparos e manutenção. Ideal para mistura de argamassa, concreto e acabamentos."
                            required
                            oninput="atualizarValidacoes()"
                        ><%= produto ? (produto.observacao || '') : '' %></textarea>
                        <span class="adm-field-hint">Campo obrigatório</span>
                    </div>

                    <!-- Linha 4: Imagem do produto (Upload Drag & Drop) -->
                    <div class="adm-field-group">
                        <label class="adm-field-label">Imagem do produto</label>
                        <input type="hidden" name="imagem_base64" id="imagem_base64">
                        <input type="hidden" name="imagem_url_atual" id="imagem_url_atual" value="<%= produto ? (produto.imagem_url || '') : '' %>">
                        <input type="file" id="fileInput" accept="image/png,image/jpeg,image/webp" style="display:none;" onchange="handleFileSelect(event)">

                        <div class="adm-upload-zone" id="dropZone" onclick="document.getElementById('fileInput').click()">
                            <div class="adm-upload-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="17 8 12 3 7 8"></polyline>
                                    <line x1="12" y1="3" x2="12" y2="15"></line>
                                </svg>
                            </div>
                            <div class="adm-upload-title" id="uploadTitle">Arraste uma imagem ou clique para enviar</div>
                            <div class="adm-upload-sub">PNG ou JPG &bull; até 5 MB</div>
                            <img 
                                id="imgPreview" 
                                class="adm-upload-preview" 
                                src="<%= (produto && produto.imagem_url) ? produto.imagem_url : '' %>"
                                style="<%= (produto && produto.imagem_url) ? 'display:inline-block;' : 'display:none;' %>"
                                alt="Pré-visualização"
                            >
                        </div>
                        <span class="adm-field-hint">Campo obrigatório</span>
                    </div>

                    <!-- Caixa de Validações em Tempo Real (Screenshot 6) -->
                    <div class="adm-validation-box">
                        <h4>Validações</h4>
                        <p>Todos os campos obrigatórios devem ser preenchidos antes do cadastro.</p>
                        <ul class="adm-val-list">
                            <li class="adm-val-item" id="valNome">
                                <span class="adm-val-dot"></span>
                                <span class="val-text">Nome do produto: pendente</span>
                            </li>
                            <li class="adm-val-item" id="valPreco">
                                <span class="adm-val-dot"></span>
                                <span class="val-text">Preço: pendente</span>
                            </li>
                            <li class="adm-val-item" id="valCategoria">
                                <span class="adm-val-dot"></span>
                                <span class="val-text">Categoria: pendente</span>
                            </li>
                            <li class="adm-val-item" id="valDescricao">
                                <span class="adm-val-dot"></span>
                                <span class="val-text">Descrição: pendente</span>
                            </li>
                            <li class="adm-val-item" id="valImagem">
                                <span class="adm-val-dot"></span>
                                <span class="val-text">Imagem do produto: pendente</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Rodapé do Card -->
                    <div class="adm-form-footer">
                        <span class="adm-form-footer-note">Ao confirmar, o produto será criado e ficará disponível para revisão no catálogo.</span>
                        <div class="adm-header-actions">
                            <% if (produto) { %>
                                <button type="submit" formaction="/admin/produtos/<%= produto.id_produto %>/excluir" class="btn-adm-outline" style="color:#dc2626; border-color:#fecaca;" onclick="return confirm('Deseja realmente excluir este produto?')">Excluir produto</button>
                            <% } else { %>
                                <button type="button" class="btn-adm-outline" onclick="salvarRascunho()">Salvar rascunho</button>
                            <% } %>
                            <button type="submit" class="btn-adm-primary"><%= produto ? 'Salvar alterações' : 'Cadastrar produto' %></button>
                        </div>
                    </div>
                </div>
            </form>
        </main>
    </div>

    <script>
        function setValStatus(id, ok, label) {
            const el = document.getElementById(id);
            const txt = el.querySelector('.val-text');
            if (ok) {
                el.classList.add('ok');
                txt.textContent = label + ': preenchido' + (label === 'Categoria' || label === 'Descrição' || label === 'Imagem do produto' ? 'a' : '');
                if (label === 'Categoria') txt.textContent = 'Categoria: preenchida';
                if (label === 'Descrição') txt.textContent = 'Descrição: preenchida';
                if (label === 'Imagem do produto') txt.textContent = 'Imagem do produto: preenchida';
            } else {
                el.classList.remove('ok');
                txt.textContent = label + ': pendente';
            }
        }

        function atualizarValidacoes() {
            const nome = document.getElementById('nome').value.trim();
            const preco = document.getElementById('valor_custo').value.trim();
            const cat = document.getElementById('id_categoria').value.trim();
            const desc = document.getElementById('observacao').value.trim();
            const imgB64 = document.getElementById('imagem_base64').value;
            const imgAtual = document.getElementById('imagem_url_atual').value;

            setValStatus('valNome', nome.length > 0, 'Nome do produto');
            setValStatus('valPreco', preco.length > 0, 'Preço');
            setValStatus('valCategoria', cat.length > 0, 'Categoria');
            setValStatus('valDescricao', desc.length > 0, 'Descrição');
            setValStatus('valImagem', (imgB64.length > 0 || imgAtual.length > 0), 'Imagem do produto');
        }

        function handleFileSelect(event) {
            const file = event.target.files && event.target.files[0];
            if (!file) return;
            processFile(file);
        }

        function processFile(file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('imagem_base64').value = e.target.result;
                const preview = document.getElementById('imgPreview');
                preview.src = e.target.result;
                preview.style.display = 'inline-block';
                document.getElementById('uploadTitle').textContent = 'Imagem selecionada: ' + file.name;
                atualizarValidacoes();
            };
            reader.readAsDataURL(file);
        }

        const dropZone = document.getElementById('dropZone');
        dropZone.addEventListener('dragover', function(e) {
            e.preventDefault();
            dropZone.classList.add('dragover');
        });
        dropZone.addEventListener('dragleave', function() {
            dropZone.classList.remove('dragover');
        });
        dropZone.addEventListener('drop', function(e) {
            e.preventDefault();
            dropZone.classList.remove('dragover');
            if (e.dataTransfer.files && e.dataTransfer.files[0]) {
                processFile(e.dataTransfer.files[0]);
            }
        });

        function salvarRascunho() {
            const dados = {
                nome: document.getElementById('nome').value,
                preco: document.getElementById('valor_custo').value,
                id_categoria: document.getElementById('id_categoria').value,
                observacao: document.getElementById('observacao').value
            };
            localStorage.setItem('agrogiuss_rascunho_produto', JSON.stringify(dados));
            alert('Rascunho salvo com sucesso!');
        }

        atualizarValidacoes();
    </script>

</body>
</html>

