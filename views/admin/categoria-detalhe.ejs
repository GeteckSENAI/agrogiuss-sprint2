<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= categoria.nome %> - Painel Administrativo | Agro Giuss</title>
    <link rel="stylesheet" href="/css/estilos-admin.css">
</head>
<body>

    <%- include('partials/topbar', { searchAction: '/admin/categorias/' + categoria.id_categoria, searchPlaceholder: 'Pesquisar produtos em ' + categoria.nome, busca: typeof busca !== 'undefined' ? busca : '' }) %>

    <div class="adm-layout">
        <%- include('partials/sidebar', {
            menuAtivo: 'categorias',
            nav04Label: categoria.nome,
            proximaAcao: 'Revisar estoque crítico e concluir cadastros pendentes da categoria ' + categoria.nome + '.'
        }) %>

        <main>
            <!-- Cabeçalho -->
            <div class="adm-header-row">
                <div>
                    <h1 class="adm-page-title"><%= categoria.nome %></h1>
                    <p class="adm-page-sub">Gerencie produtos, estoque, preços e status da categoria <%= categoria.nome %> em uma visão centralizada.</p>
                </div>
                <div class="adm-header-actions">
                    <a href="/admin/categorias" class="btn-adm-outline">&larr; Categorias</a>
                    <a href="/admin/relatorio.csv" class="btn-adm-outline">Exportar relatório</a>
                    <a href="/admin/produtos/novo?categoria=<%= categoria.id_categoria %>" class="btn-adm-primary">Novo produto</a>
                </div>
            </div>

            <!-- 4 KPI Cards (Screenshot 5) -->
            <% 
                const prodAtivos = produtos.filter(p => p.ativo).length;
                const prodCriticos = produtos.filter(p => Number(p.quantidade_estoque) <= Number(p.estoque_minimo)).length;
                const cobCat = produtos.length > 0 ? Math.round(((produtos.length - prodCriticos) / produtos.length) * 100) : 100;
            %>
            <div class="adm-kpi-grid">
                <div class="adm-kpi-card">
                    <div class="adm-kpi-top">
                        <span class="adm-kpi-label">Produtos ativos</span>
                        <span class="adm-icon-badge">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>
                        </span>
                    </div>
                    <div class="adm-kpi-value"><%= prodAtivos %></div>
                    <div class="adm-kpi-foot">Produtos listados nesta categoria</div>
                </div>

                <div class="adm-kpi-card">
                    <div class="adm-kpi-top">
                        <span class="adm-kpi-label">Estoque crítico</span>
                        <span class="adm-icon-badge">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        </span>
                    </div>
                    <div class="adm-kpi-value"><%= prodCriticos %></div>
                    <div class="adm-kpi-foot">Itens precisam de reposição imediata</div>
                </div>

                <div class="adm-kpi-card">
                    <div class="adm-kpi-top">
                        <span class="adm-kpi-label">Última atualização</span>
                        <span class="adm-icon-badge">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                        </span>
                    </div>
                    <div class="adm-kpi-value" style="font-size:24px;"><%= new Date().toLocaleDateString('pt-BR') %></div>
                    <div class="adm-kpi-foot">Data mais recente de atualização</div>
                </div>

                <div class="adm-kpi-card">
                    <div class="adm-kpi-top">
                        <span class="adm-kpi-label">Cobertura</span>
                        <span class="adm-icon-badge">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        </span>
                    </div>
                    <div class="adm-kpi-value"><%= cobCat %>%</div>
                    <div class="adm-kpi-foot"><%= prodCriticos %> produtos com estoque abaixo do mínimo</div>
                </div>
            </div>

            <!-- Barra de Filtros -->
            <form class="adm-filter-bar" action="/admin/categorias/<%= categoria.id_categoria %>" method="GET">
                <div class="adm-filter-left">
                    <div class="adm-search-pill">
                        <input type="text" name="busca" placeholder="Pesquisar produtos" value="<%= typeof busca !== 'undefined' ? busca : '' %>">
                        <button type="submit">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        </button>
                    </div>

                    <select class="adm-select-pill">
                        <option>Status: Todos</option>
                    </select>

                    <select class="adm-select-pill">
                        <option>Tipo: Produtos</option>
                    </select>
                </div>

                <div class="adm-view-toggle">
                    <button type="button" class="adm-view-btn active" id="btnGrade" onclick="setModo('grade')">Grade</button>
                    <button type="button" class="adm-view-btn" id="btnLista" onclick="setModo('lista')">Lista</button>
                </div>
            </form>

            <!-- Grid de Produtos da Categoria (Screenshot 5) -->
            <% if (produtos && produtos.length > 0) { %>
                <div class="adm-cards-grid" id="cardsGrid">
                    <% produtos.forEach(function(prod) { 
                        const dataStr = prod.data_cadastro ? new Date(prod.data_cadastro).toLocaleDateString('pt-BR') : '29/03/2025';
                    %>
                        <article class="adm-catalog-card">
                            <div class="adm-card-img-wrap">
                                <img src="<%= prod.imagem_url || '/img/logo.png' %>" alt="<%= prod.nome %>" class="adm-card-img contain-img">
                            </div>

                            <div class="adm-card-body">
                                <h3 class="adm-card-title"><%= prod.nome %></h3>
                                <p class="adm-card-desc"><%= prod.observacao || 'Produto oficial do catálogo Agro Giuss.' %></p>
                                <span class="adm-card-date"><%= dataStr %> &bull; R$ <%= Number(prod.valor_custo).toFixed(2).replace('.', ',') %></span>
                            </div>

                            <div class="adm-card-footer">
                                <span class="adm-card-count"><%= prod.quantidade_estoque %> unidades</span>
                                <a href="/admin/produtos/<%= prod.id_produto %>/editar" class="btn-adm-mint">Editar</a>
                            </div>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="adm-panel-card" style="text-align:center; padding:42px; margin-bottom:20px;">
                    <p style="font-size:15px; color:#52525b; margin-bottom:14px;">Nenhum produto cadastrado nesta categoria ainda.</p>
                    <a href="/admin/produtos/novo?categoria=<%= categoria.id_categoria %>" class="btn-adm-primary">Cadastrar primeiro produto em <%= categoria.nome %></a>
                </div>
            <% } %>

            <!-- Banner Inferior: Adicionar produtos -->
            <div class="adm-cta-bar">
                <div>
                    <h3>Adicionar produtos</h3>
                    <p>Crie novos produtos e organize a categoria <%= categoria.nome %> com status, preços e estoque visíveis.</p>
                </div>
                <a href="/admin/produtos/novo?categoria=<%= categoria.id_categoria %>" class="btn-adm-primary">Novo produto</a>
            </div>
        </main>
    </div>

    <script>
        function setModo(modo) {
            const grid = document.getElementById('cardsGrid');
            if (!grid) return;
            const btnGrade = document.getElementById('btnGrade');
            const btnLista = document.getElementById('btnLista');
            if (modo === 'lista') {
                grid.classList.add('list-mode');
                btnLista.classList.add('active');
                btnGrade.classList.remove('active');
            } else {
                grid.classList.remove('list-mode');
                btnGrade.classList.add('active');
                btnLista.classList.remove('active');
            }
        }
    </script>

</body>
</html>

