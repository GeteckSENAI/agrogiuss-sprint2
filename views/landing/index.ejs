<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agro Giuss - A Força do Campo e a Praticidade para o seu Dia a Dia</title>
    <link rel="stylesheet" href="/css/estilos-lp.css">
</head>
<body>

    <!-- 1. BARRA SUPERIOR (HEADER CINZA-CLARO) -->
    <header class="top-header">
        <div class="container top-header-inner">
            <a href="/" class="logo-wrapper">
                <img src="/img/logo.png" alt="Agro Giuss" class="logo">
            </a>

            <div class="top-actions">
                <form class="search-box" action="/catalogo" method="GET">
                    <input type="text" name="busca" class="search-input" placeholder="Pesquisar produtos, sementes, rações..." aria-label="Pesquisar produtos">
                    <button type="submit" class="search-btn" aria-label="Buscar">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </button>
                </form>

                <a href="/catalogo" class="menu-hamburger-btn" aria-label="Abrir catálogo">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </a>
            </div>
        </div>
    </header>

    <!-- 2. BARRA DE NAVEGAÇÃO (VERDE-CLARA #a6eeb0) -->
    <nav class="main-navbar">
        <div class="container navbar-inner">
            <ul class="nav-links">
                <li><a href="/" class="nav-link active">Início</a></li>
                <li><a href="/catalogo" class="nav-link">Catálogo</a></li>
                <li><a href="/catalogo?ordem=menor-preco" class="nav-link">Ofertas</a></li>
                <li><a href="/pedidos" class="nav-link">Meus pedidos</a></li>
            </ul>

            <% if (typeof usuarioNome !== 'undefined' && usuarioNome) { %>
                <div style="display:flex; align-items:center; gap:12px;">
                    <% if (typeof usuarioTipo !== 'undefined' && usuarioTipo === 'admin') { %>
                        <a href="/admin" class="nav-auth" style="font-weight:700;">Painel Admin</a>
                    <% } else { %>
                        <span class="nav-auth">Olá, <%= usuarioNome %></span>
                    <% } %>
                    <a href="/logout" class="nav-auth" style="opacity:0.75;">(Sair)</a>
                </div>
            <% } else { %>
                <a href="/login" class="nav-auth">Entrar / Criar conta</a>
            <% } %>
        </div>
    </nav>

    <!-- CONTEÚDO PRINCIPAL -->
    <main>
        <!-- 3. SEÇÃO HERO (2 COLUNAS) -->
        <section class="hero-section">
            <div class="container hero-grid">
                <div class="hero-content">
                    <div class="badge">
                        Soluções para campo, casa e rebanho &bull; Mirandópolis e Região
                    </div>
                    
                    <h1 class="hero-title">
                        A Força do Campo e a Praticidade para o seu Dia a Dia em um Só Lugar.
                    </h1>

                    <p class="hero-subtitle">
                        Encontre ferramentas, insumos agrícolas, sementes, suplementos minerais, rações e acessórios com estoque em tempo real e pronta entrega.
                    </p>

                    <div class="hero-buttons">
                        <a href="/catalogo" class="btn btn-primary">Conheça nossos produtos</a>
                        <a href="/admin/login" class="btn btn-secondary">Acesso administrativo</a>
                    </div>
                </div>

                <div class="hero-image-wrapper">
                    <img src="/img/hero.jpg" alt="Interior da Loja Agro Giuss" class="hero-image">
                </div>
            </div>
        </section>

        <!-- 4. FAIXA DE INDICADORES / CONFIANÇA -->
        <section class="stats-strip-section">
            <div class="container">
                <div class="stats-strip-grid">
                    <div class="stat-strip-item">
                        <div class="stat-strip-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                        </div>
                        <div class="stat-strip-text">
                            <strong>+<%= typeof totalProdutos !== 'undefined' ? totalProdutos : 12 %> Linhas</strong>
                            <span>Produtos prontos para retirada</span>
                        </div>
                    </div>

                    <div class="stat-strip-item">
                        <div class="stat-strip-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        </div>
                        <div class="stat-strip-text">
                            <strong>10 Setores</strong>
                            <span>Do plantio à manutenção do lar</span>
                        </div>
                    </div>

                    <div class="stat-strip-item">
                        <div class="stat-strip-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        </div>
                        <div class="stat-strip-text">
                            <strong>Entrega Ágil</strong>
                            <span>Atendimento rápido na região</span>
                        </div>
                    </div>

                    <div class="stat-strip-item">
                        <div class="stat-strip-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        </div>
                        <div class="stat-strip-text">
                            <strong>100% Garantido</strong>
                            <span>Marcas líderes do agronegócio</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. VITRINE DE PRODUTOS EM DESTAQUE (DINÂMICO DO POSTGRESQL) -->
        <% if (typeof destaques !== 'undefined' && destaques.length > 0) { %>
        <section class="featured-section">
            <div class="container">
                <div class="section-header-row">
                    <div>
                        <span class="section-badge-pill">Catálogo em tempo real</span>
                        <h2 class="services-title">Produtos em destaque na Agro Giuss</h2>
                        <p class="services-subtitle" style="margin-bottom:0;">Os itens mais procurados para lavoura, pecuária, construção e cuidado com animais.</p>
                    </div>
                    <a href="/catalogo" class="btn btn-secondary">Ver todos os produtos &rarr;</a>
                </div>

                <div class="lp-products-grid">
                    <% destaques.forEach(function(prod) { %>
                        <article class="lp-product-card">
                            <span class="lp-product-cat-tag"><%= prod.categoria_nome || 'Agro Giuss' %></span>
                            <a href="/produto/<%= prod.id_produto %>" class="lp-product-img-wrap">
                                <img src="<%= prod.imagem_url || '/img/logo.png' %>" alt="<%= prod.nome %>">
                            </a>
                            <h3 class="lp-product-title">
                                <a href="/produto/<%= prod.id_produto %>"><%= prod.nome %></a>
                            </h3>
                            <p class="lp-product-desc"><%= prod.observacao %></p>
                            <div class="lp-product-bottom">
                                <div class="lp-product-price">
                                    <small>Preço à vista</small>
                                    R$ <%= Number(prod.valor_custo).toFixed(2).replace('.', ',') %>
                                </div>
                                <a href="/produto/<%= prod.id_produto %>" class="lp-btn-buy">Comprar</a>
                            </div>
                        </article>
                    <% }); %>
                </div>
            </div>
        </section>
        <% } %>

        <!-- 6. NAVEGUE POR DEPARTAMENTOS (CATEGORIAS COM FOTOS) -->
        <section class="departments-section">
            <div class="container">
                <div class="section-header-row">
                    <div>
                        <span class="section-badge-pill">Departamentos completos</span>
                        <h2 class="services-title">Explore por linha de soluções</h2>
                        <p class="services-subtitle" style="margin-bottom:0;">Clique em um setor para filtrar diretamente os produtos que você precisa.</p>
                    </div>
                </div>

                <div class="departments-grid">
                    <a href="/catalogo?categoria=2" class="dept-card">
                        <img src="https://images.unsplash.com/photo-1625246333195-78d9c38ad449?auto=format&fit=crop&w=800&q=80" alt="Agricultura e Plantio">
                        <div class="dept-card-content">
                            <div>
                                <h3>Agricultura &amp; Plantio</h3>
                                <p>Adubos NPK, sementes híbridas e pulverização</p>
                            </div>
                            <span class="dept-card-arrow">&rarr;</span>
                        </div>
                    </a>

                    <a href="/catalogo?categoria=3" class="dept-card">
                        <img src="https://images.unsplash.com/photo-1553284965-83fd3e82fa5a?auto=format&fit=crop&w=800&q=80" alt="Animais e Pecuária">
                        <div class="dept-card-content">
                            <div>
                                <h3>Nutrição &amp; Saúde Animal</h3>
                                <p>Rações premium, sal mineral e suplementos</p>
                            </div>
                            <span class="dept-card-arrow">&rarr;</span>
                        </div>
                    </a>

                    <a href="/catalogo?categoria=1" class="dept-card">
                        <img src="https://images.unsplash.com/photo-1504148455328-c376907d081c?auto=format&fit=crop&w=800&q=80" alt="Ferramentas e EPIs">
                        <div class="dept-card-content">
                            <div>
                                <h3>Ferramentas, Casa &amp; EPIs</h3>
                                <p>Utensílios pesados, botinas de couro, tintas e jardim</p>
                            </div>
                            <span class="dept-card-arrow">&rarr;</span>
                        </div>
                    </a>
                </div>
            </div>
        </section>

        <!-- 7. SEÇÃO INSTITUCIONAL (MISSÃO/VISÃO/VALORES) -->
        <section class="institutional-section">
            <div class="container">
                <h2 class="institutional-title">O coração no agro. As portas abertas para tudo.</h2>
                <p class="institutional-text">
                    Nós nascemos com a missão de fortalecer quem planta e cria, mas crescemos para atender todas as suas necessidades. Na Agro Giuss, você não precisa ir a vários lugares para riscar sua lista de compras. Seja para equipar sua propriedade rural, garantir a saúde do seu rebanho ou buscar aquela ferramenta de reparo essencial para a sua casa em Mirandópolis e região, nós temos a solução.
                </p>
            </div>
        </section>

        <!-- 8. SEÇÃO DE SERVIÇOS ("O QUE VOCÊ ENCONTRA NA AGRO GIUSS?") -->
        <section class="services-section">
            <div class="container">
                <h2 class="services-title">O que você encontra na Agro Giuss?</h2>
                <p class="services-subtitle">Tudo para garantir a produtividade e a segurança da sua propriedade com as melhores marcas do mercado:</p>

                <div class="services-grid">
                    <div class="service-card">
                        <div class="service-icon-box">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            </svg>
                        </div>
                        <h3 class="service-card-title">Insumos e Defensivos</h3>
                        <p class="service-card-desc">Fertilizantes e soluções de alta qualidade para o cuidado com a terra e o rendimento da lavoura.</p>
                    </div>

                    <div class="service-card">
                        <div class="service-icon-box">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
                        </div>
                        <h3 class="service-card-title">Nutrição e Saúde Animal</h3>
                        <p class="service-card-desc">Rações, sais minerais, suplementos e medicamentos para grandes e pequenos animais.</p>
                    </div>

                    <div class="service-card">
                        <div class="service-icon-box">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                            </svg>
                        </div>
                        <h3 class="service-card-title">Ferramentas e Maquinário</h3>
                        <p class="service-card-desc">Peças de reposição, implementos agrícolas e ferramentas pesadas para o trabalho bruto.</p>
                    </div>

                    <div class="service-card">
                        <div class="service-icon-box">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                                <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
                            </svg>
                        </div>
                        <h3 class="service-card-title">EPIs e Segurança</h3>
                        <p class="service-card-desc">Botinas, luvas e equipamentos completos para a proteção do trabalhador do campo.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 9. DEPOIMENTOS DE CLIENTES E PRODUTORES -->
        <section class="testimonials-section">
            <div class="container">
                <span class="section-badge-pill">Quem compra, recomenda</span>
                <h2 class="services-title">A parceria de confiança do produtor e da família</h2>
                <p class="services-subtitle">Veja como a Agro Giuss apoia o trabalho diário no campo e na cidade:</p>

                <div class="testimonials-grid">
                    <div class="testimonial-card">
                        <div>
                            <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <p class="testimonial-quote">"Sempre encontro adubo, sal mineral e ferramentas de primeira linha com pronta entrega. O catálogo online facilitou demais consultar o estoque antes de ir buscar."</p>
                        </div>
                        <div class="testimonial-author">
                            <div class="testimonial-avatar">RM</div>
                            <div>
                                <strong>Roberto Mendes</strong>
                                <span>Produtor Rural &bull; Mirandópolis - SP</span>
                            </div>
                        </div>
                    </div>

                    <div class="testimonial-card">
                        <div>
                            <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <p class="testimonial-quote">"Preços excelentes nas rações Special Dog e Quidog, além de toda a linha de jardinagem e tintas para manutenção da chácara. Atendimento nota dez!"</p>
                        </div>
                        <div class="testimonial-author">
                            <div class="testimonial-avatar">CS</div>
                            <div>
                                <strong>Cláudia Soares</strong>
                                <span>Cliente &amp; Criadora &bull; Lavínia - SP</span>
                            </div>
                        </div>
                    </div>

                    <div class="testimonial-card">
                        <div>
                            <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <p class="testimonial-quote">"Equipamos toda a nossa equipe com botinas de couro, pulverizadores costais e ferramentas manuais da Agro Giuss. Durabilidade e confiança em um só lugar."</p>
                        </div>
                        <div class="testimonial-author">
                            <div class="testimonial-avatar">MA</div>
                            <div>
                                <strong>Marcos Almeida</strong>
                                <span>Gestor Agropecuário &bull; Guaraçaí - SP</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 10. BANNER INFERIOR (CTA) -->
        <section class="cta-section">
            <div class="container">
                <div class="cta-box">
                    <div class="cta-content">
                        <h3 class="cta-title">Pronto para comprar ou administrar sua conta?</h3>
                        <p class="cta-subtitle">Use o acesso público para navegar pelo catálogo e pedidos, ou acesse a área administrativa para gerenciar operações, estoque e usuários.</p>
                    </div>

                    <div class="cta-buttons">
                        <a href="/catalogo" class="btn btn-primary">Acessar catálogo</a>
                        <a href="/admin/login" class="btn btn-secondary">Acesso administrativo</a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- 11. RODAPÉ INSTITUCIONAL COMPLETO -->
    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <img src="/img/logo.png" alt="Agro Giuss" style="height:36px; margin-bottom:12px;">
                    <p style="line-height:1.6; color:#52525b;">
                        Soluções completas para agricultura, pecuária, jardinagem, pesca, ferramentas e manutenção residencial em Mirandópolis e região.
                    </p>
                </div>

                <div class="footer-col">
                    <h4>Navegação Rápida</h4>
                    <ul class="footer-links">
                        <li><a href="/">Página Inicial</a></li>
                        <li><a href="/catalogo">Catálogo Completo</a></li>
                        <li><a href="/catalogo?ordem=menor-preco">Ofertas da Semana</a></li>
                        <li><a href="/pedidos">Meus Pedidos e Carrinho</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Principais Linhas</h4>
                    <ul class="footer-links">
                        <li><a href="/catalogo?categoria=2">Agricultura &amp; Adubos</a></li>
                        <li><a href="/catalogo?categoria=4">Rações &amp; Nutrição Animal</a></li>
                        <li><a href="/catalogo?categoria=1">Ferramentas &amp; Utensílios</a></li>
                        <li><a href="/catalogo?categoria=9">Jardim, Casa &amp; Pesca</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Atendimento &amp; Gestão</h4>
                    <ul class="footer-links">
                        <li>Mirandópolis - SP e Região</li>
                        <li>Seg. a Sex. das 07h30 às 18h00 &bull; Sáb. até 12h30</li>
                        <li style="margin-top:6px;"><a href="/login" style="font-weight:600; color:#15803d;">&rarr; Área do Cliente</a></li>
                        <li><a href="/admin/login" style="font-weight:600; color:#15803d;">&rarr; Painel Administrativo</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom">
                <span>&copy; <%= new Date().getFullYear() %> Agro Giuss &bull; Todos os direitos reservados.</span>
                <span>Sistema Integrado de Catálogo e Gestão de Estoque (PostgreSQL)</span>
            </div>
        </div>
    </footer>

    <script src="/js/loja.js"></script>
</body>
</html>
