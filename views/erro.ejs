<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= codigo %> - Agro Giuss</title>
    <link rel="stylesheet" href="/css/estilos-sistema.css">
    <style>
        .erro-page {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #f9fafb;
            text-align: center;
            padding: 40px 20px;
        }
        .erro-logo {
            height: 48px;
            margin-bottom: 40px;
        }
        .erro-codigo {
            font-size: 120px;
            font-weight: 800;
            color: #38b049;
            line-height: 1;
            margin-bottom: 8px;
            letter-spacing: -4px;
        }
        .erro-titulo {
            font-size: 24px;
            font-weight: 700;
            color: #18181b;
            margin-bottom: 12px;
        }
        .erro-descricao {
            font-size: 15px;
            color: #71717a;
            max-width: 420px;
            margin: 0 auto 36px;
            line-height: 1.6;
        }
        .erro-acoes {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }
        .btn-voltar-inicio {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            background: #38b049;
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            border-radius: 8px;
            text-decoration: none;
            transition: background 0.2s;
        }
        .btn-voltar-inicio:hover { background: #2fa03f; }
        .btn-voltar-catalogo {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            background: #fff;
            color: #18181b;
            font-size: 14px;
            font-weight: 600;
            border-radius: 8px;
            border: 1.5px solid #e5e7eb;
            text-decoration: none;
            transition: border-color 0.2s;
        }
        .btn-voltar-catalogo:hover { border-color: #38b049; color: #38b049; }
        .erro-mascote {
            width: 160px;
            margin-bottom: 32px;
            opacity: 0.85;
        }
    </style>
</head>
<body>
    <div class="erro-page">
        <img src="/img/logo.png" alt="Agro Giuss" class="erro-logo">
        <img src="/img/fazendeiro.png" alt="Fazendeiro" class="erro-mascote">
        <div class="erro-codigo"><%= codigo %></div>
        <h1 class="erro-titulo"><%= titulo %></h1>
        <p class="erro-descricao"><%= mensagem %></p>
        <div class="erro-acoes">
            <a href="/" class="btn-voltar-inicio">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                </svg>
                Voltar ao início
            </a>
            <a href="/catalogo" class="btn-voltar-catalogo">Ver catálogo</a>
        </div>
    </div>
</body>
</html>

